# Python: cache files generated by the interpreter.
__pycache__/
*.py[cod]
*$py.class

# Virtual environments: recreate them from requirements.txt.
.venv/
env/
venv/

# Django and local databases/logs: machine-specific runtime state.
*.log
logs/
local_settings.py
db.sqlite3
*.sqlite3
staticfiles/

# Test and coverage output: generated reports, not source or test cases.
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/

# IDE/editor state: personal workspace preferences.
.vscode/
.vs/
.idea/

# Build/package output: regenerate from source and requirements.
build/
dist/
*.egg-info/

# Installer logs: transient output from pip.
pip-log.txt
pip-delete-this-directory.txt

# Operating-system metadata.
.DS_Store
Thumbs.db

# Local configuration and secrets: never commit credentials or signing keys.
.env
.env.*
!.env.example
config/conexiones.local.json
configurar-entorno.ps1
.django-secret-key

# Exported and backup data: may contain personal, business, or production records.
exportaciones*/
datos_limpios*.jsonl
respaldos/
